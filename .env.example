# Copy to .env — .env is git-ignored and never bundled. Only server/ea.ts reads these.
# Any one of these keys works. EA_API_KEY wins if several are set.
EA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible base URL. Defaults to OpenRouter.
#   OpenRouter  https://openrouter.ai/api/v1   (default)
#   OpenAI      https://api.openai.com/v1
#   Anthropic   https://api.anthropic.com/v1   (compatibility endpoint)
EA_BASE_URL=

# Provider-qualified model id. Defaults to openai/gpt-4o-mini (cheap, good enough
# for one-sentence answers). Examples:
#   anthropic/claude-sonnet-4.5      openai/gpt-4o-mini
#   google/gemini-2.5-flash          meta-llama/llama-3.3-70b-instruct
EA_MODEL=
